---
import AsterLayout from "../../layouts/AsterLayout.astro";
import { ASTER_DEX_ID, AUTHORS, PERSON_ID, SITE_URL } from "../../entity";
import { buildAsterPageGraph, buildBreadcrumbs } from "../../lib/schema";
import {
  ASTER_BRIDGE_CONTRACTS,
  ASTER_DOCS,
  ASTER_EARN_CONTRACTS,
  ASTER_LAST_VERIFIED,
  ASTER_USDF_CONTRACTS,
} from "../../data/aster";

const url = `${SITE_URL}/aster-dex/contracts/`;
const description =
  "Verified Aster DEX contract addresses across BNB Chain, Ethereum, Arbitrum, Solana and SUI, plus the Earn and USDF token contracts.";

const citationUrl = `${ASTER_DOCS}overview/smart-contracts`;

const articleNode = {
  "@type": "TechArticle",
  "@id": `${url}#article`,
  headline: "Aster DEX contract addresses",
  name: "Aster DEX contract addresses",
  description,
  url,
  mainEntityOfPage: url,
  inLanguage: "en",
  datePublished: "2026-11-24",
  dateModified: ASTER_LAST_VERIFIED,
  author: { "@id": AUTHORS.kirsty.id },
  editor: { "@id": AUTHORS.maksim.id },
  publisher: { "@id": PERSON_ID },
  isPartOf: { "@id": `${SITE_URL}/aster-dex/#collection` },
  articleSection: "Registry",
  about: [
    { "@id": ASTER_DEX_ID },
    { "@type": "Thing", name: "Smart contract", sameAs: "https://www.wikidata.org/wiki/Q7544035" },
  ],
  citation: [{ "@type": "CreativeWork", name: "Aster smart contracts", url: citationUrl }],
};

const breadcrumbs = buildBreadcrumbs(`${url}#breadcrumbs`, [
  { name: "Home", url: `${SITE_URL}/` },
  { name: "Aster DEX", url: `${SITE_URL}/aster-dex/` },
  { name: "Contracts", url },
]);

const graph = buildAsterPageGraph([articleNode, breadcrumbs]);

const tokenContracts = [...ASTER_EARN_CONTRACTS, ...ASTER_USDF_CONTRACTS];
---

<AsterLayout
  title="Aster DEX Contract Addresses — Verified Registry | Maksim Sokal"
  description={description}
  canonical={url}
  graph={graph}
  trail={[{ label: "Contracts" }]}
  modified={new Date(ASTER_LAST_VERIFIED)}
>
  <header class="space-y-5 max-w-3xl">
    <span class="text-xs font-mono text-sky-400 uppercase tracking-widest block">Registry</span>
    <h1 class="font-display font-medium text-3xl md:text-4xl text-slate-100 tracking-tight leading-tight">
      Aster DEX contract addresses
    </h1>
    <p class="text-sm text-slate-300 leading-relaxed">
      Every address below is copied from the official Aster registry and linked to a public explorer where one is
      available. The registry is the only acceptable source for an address; search results, ads and direct messages are
      not.
    </p>
    <p class="text-[11px] font-mono text-slate-400">
      Verified <time datetime={ASTER_LAST_VERIFIED}>{ASTER_LAST_VERIFIED}</time> against{" "}
      <a href={citationUrl} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300">docs.asterdex.com/overview/smart-contracts</a>
    </p>
  </header>

  <section class="space-y-4" aria-labelledby="bridge-heading">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[#1e293b]/60 pb-3">
      <h2 id="bridge-heading" class="font-display font-medium text-xl text-slate-100 tracking-tight">Deposit bridge</h2>
      <span class="text-[10px] font-mono text-slate-400">5 chains</span>
    </div>
    <div class="overflow-x-auto rounded-xl border border-[#1e293b]/60">
      <table class="w-full text-sm font-mono">
        <thead>
          <tr class="bg-brand-950/60 border-b border-[#1e293b]/40">
            <th scope="col" class="text-left text-[10px] text-slate-400 uppercase tracking-widest px-5 py-3 font-semibold">Network</th>
            <th scope="col" class="text-left text-[10px] text-slate-400 uppercase tracking-widest px-5 py-3 font-semibold">Address</th>
          </tr>
        </thead>
        <tbody>
          {ASTER_BRIDGE_CONTRACTS.map((contract) => (
            <tr class="border-b border-[#1e293b]/30 last:border-b-0">
              <td class="px-5 py-4 text-xs text-slate-200 whitespace-nowrap">{contract.network}</td>
              <td class="px-5 py-4">
                <a
                  href={contract.explorer}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sky-300 hover:text-sky-200 underline underline-offset-2 decoration-sky-500/30 text-xs break-all"
                >
                  {contract.address}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-4" aria-labelledby="token-heading">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[#1e293b]/60 pb-3">
      <h2 id="token-heading" class="font-display font-medium text-xl text-slate-100 tracking-tight">Earn and USDF contracts</h2>
      <span class="text-[10px] font-mono text-slate-400">10 contracts</span>
    </div>
    <p class="text-xs text-slate-400 leading-relaxed">
      The official registry lists these as EVM addresses but does not label a network for them. Confirm the chain on the
      official page before interacting.
    </p>
    <div class="overflow-x-auto rounded-xl border border-[#1e293b]/60">
      <table class="w-full text-sm font-mono">
        <thead>
          <tr class="bg-brand-950/60 border-b border-[#1e293b]/40">
            <th scope="col" class="text-left text-[10px] text-slate-400 uppercase tracking-widest px-5 py-3 font-semibold">Contract</th>
            <th scope="col" class="text-left text-[10px] text-slate-400 uppercase tracking-widest px-5 py-3 font-semibold">Address</th>
          </tr>
        </thead>
        <tbody>
          {tokenContracts.map((contract) => (
            <tr class="border-b border-[#1e293b]/30 last:border-b-0">
              <td class="px-5 py-4 text-xs text-slate-200 whitespace-nowrap">{contract.label}</td>
              <td class="px-5 py-4">
                <code class="text-xs text-slate-300 break-all">{contract.address}</code>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-4" aria-labelledby="check-heading">
    <h2 id="check-heading" class="font-display font-medium text-xl text-slate-100 tracking-tight">How to check an address yourself</h2>
    <ol class="space-y-3 text-xs text-slate-300 leading-relaxed list-decimal pl-5">
      <li>Open the official registry page and compare the address character by character. Never copy from a screenshot.</li>
      <li>Use the explorer link in the table above. On EVM chains, confirm the contract is verified and inspect the proxy implementation slot.</li>
      <li>For Solana and SUI, confirm the account or object exists and matches the product the docs describe.</li>
      <li>If an address appears anywhere else first — a DM, an ad, a search result — treat it as unverified until it matches the registry.</li>
    </ol>
    <p class="text-[11px] text-slate-400">
      The verification method is documented in{" "}
      <a href="/research/aster-dex-contract-verification/" class="text-sky-400 hover:text-sky-300 underline underline-offset-2 decoration-sky-500/30">the registry verification checklist</a>.
    </p>
  </section>

  <section class="border-t border-[#1e293b]/60 pt-6 space-y-3" aria-labelledby="sources-heading">
    <h2 id="sources-heading" class="font-display font-medium text-sm text-slate-200 tracking-wide">Sources</h2>
    <ul class="space-y-2 text-[11px]">
      <li>
        <a href={citationUrl} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 underline underline-offset-2 decoration-sky-500/30">
          Aster smart contracts
        </a>
        <span class="text-slate-500"> — official registry</span>
      </li>
      <li>
        <a href={`${ASTER_DOCS}aster-chain/overview`} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 underline underline-offset-2 decoration-sky-500/30">
          Aster Chain overview
        </a>
        <span class="text-slate-500"> — bridge and validator model</span>
      </li>
    </ul>
    <p class="text-[11px] text-slate-400 pt-2">
      Written by <a href="/kirsty-moreland/" class="text-sky-400 hover:text-sky-300">Kirsty Moreland</a> · Technical review by{" "}
      <a href="/about/" class="text-sky-400 hover:text-sky-300">Maksim Sokal</a> ·{" "}
      <a href="/disclosure/" class="text-slate-400 hover:text-sky-300">Disclosure</a>
    </p>
  </section>
</AsterLayout>
