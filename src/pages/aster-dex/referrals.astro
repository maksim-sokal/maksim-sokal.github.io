---
import AsterLayout from "../../layouts/AsterLayout.astro";
import { ASTER_DEX_ID, AUTHORS, PERSON_ID, SITE_URL } from "../../entity";
import { buildAsterPageGraph, buildBreadcrumbs } from "../../lib/schema";
import { ASTER_DOCS, ASTER_LAST_VERIFIED } from "../../data/aster";

const url = `${SITE_URL}/aster-dex/referrals/`;
const description =
  "How the Aster referral program works: the default 10% commission split, affiliate tiers, the 365-day relationship, exclusions and the legal responsibility that comes with promoting leverage.";

const articleNode = {
  "@type": "TechArticle",
  "@id": `${url}#article`,
  headline: "Referral program",
  alternativeHeadline: "Aster referral program: rates, rules and risks",
  name: "Aster referral program: rates, rules and risks",
  description,
  url,
  mainEntityOfPage: url,
  inLanguage: "en",
  datePublished: "2026-11-24",
  dateModified: ASTER_LAST_VERIFIED,
  author: { "@id": AUTHORS.kirsty.id },
  editor: { "@id": AUTHORS.maksim.id },
  publisher: { "@id": PERSON_ID },
  isPartOf: { "@id": `${SITE_URL}/aster-dex/#collection` },
  articleSection: "Programs",
  about: [
    { "@id": ASTER_DEX_ID },
    { "@type": "Thing", name: "Affiliate marketing", sameAs: "https://www.wikidata.org/wiki/Q382453" },
  ],
  citation: [
    { "@type": "CreativeWork", name: "Referral program", url: `${ASTER_DOCS}program-and-rewards/referral-program` },
    { "@type": "CreativeWork", name: "Terms and conditions", url: `${ASTER_DOCS}resources/terms-and-conditions` },
  ],
};

const breadcrumbs = buildBreadcrumbs(`${url}#breadcrumbs`, [
  { name: "Home", url: `${SITE_URL}/` },
  { name: "Aster DEX", url: `${SITE_URL}/aster-dex/` },
  { name: "Referrals", url },
]);

const graph = buildAsterPageGraph([articleNode, breadcrumbs]);
---

<AsterLayout
  title="Aster Referral Program — Commission, Rules and Risk | Maksim Sokal"
  description={description}
  canonical={url}
  graph={graph}
  trail={[{ label: "Referrals" }]}
  modified={new Date(ASTER_LAST_VERIFIED)}
>
  <header class="space-y-5 max-w-3xl">
    <span class="text-xs font-mono text-sky-400 uppercase tracking-widest block">Programs</span>
    <h1 class="font-display font-medium text-3xl md:text-4xl text-slate-100 tracking-tight leading-tight">
      Referral program
    </h1>
    <p class="text-sm text-slate-300 leading-relaxed">
      Aster pays commission on trading fees generated by people you refer. The default rate is 10%, split with the
      referee however you choose. The rules include a 365-day attribution window, a list of excluded volume and an
      explicit obligation on the referrer to understand local law.
    </p>
    <p class="text-[11px] font-mono text-slate-400">
      Verified <time datetime={ASTER_LAST_VERIFIED}>{ASTER_LAST_VERIFIED}</time> ·{" "}
      <a href={`${ASTER_DOCS}program-and-rewards/referral-program`} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300">official referral docs</a>
    </p>
  </header>

  <section class="grid grid-cols-1 sm:grid-cols-3 gap-3" aria-label="Referral rates">
    <div class="bg-brand-900/35 border border-[#1e293b]/60 rounded-xl p-5 space-y-1">
      <span class="text-[10px] font-mono uppercase tracking-widest text-sky-400">Default commission</span>
      <span class="text-2xl font-display text-slate-100">10%</span>
      <span class="block text-[11px] text-slate-400">Split between referrer and referee</span>
    </div>
    <div class="bg-brand-900/35 border border-[#1e293b]/60 rounded-xl p-5 space-y-1">
      <span class="text-[10px] font-mono uppercase tracking-widest text-sky-400">Approved affiliates — VIP 1</span>
      <span class="text-2xl font-display text-slate-100">20%</span>
      <span class="block text-[11px] text-slate-400">From referred VIP 1 users</span>
    </div>
    <div class="bg-brand-900/35 border border-[#1e293b]/60 rounded-xl p-5 space-y-1">
      <span class="text-[10px] font-mono uppercase tracking-widest text-sky-400">Approved affiliates — VIP 2+</span>
      <span class="text-2xl font-display text-slate-100">10%</span>
      <span class="block text-[11px] text-slate-400">From referred VIP 2 and above</span>
    </div>
  </section>

  <section class="space-y-3" aria-labelledby="rules-heading">
    <h2 id="rules-heading" class="font-display font-medium text-xl text-slate-100 tracking-tight">The rules that decide the payout</h2>
    <ul class="space-y-2 text-xs text-slate-400 leading-relaxed list-disc pl-5">
      <li>Attribution lasts 365 days by default; Aster may extend it at its discretion.</li>
      <li>Only new users who sign up through your link are eligible. There is no cap on the number you can invite.</li>
      <li>Liquidation fees, self-trade volume and zero-fee trade volume are excluded from commission.</li>
      <li>Self-referrals across multiple accounts are prohibited and can revoke all rewards.</li>
      <li>Rebate rates are calculated daily at 00:00 UTC and updated at 09:00 UTC.</li>
      <li>Rewards are paid in the asset the referee used to pay fees, by the following day.</li>
      <li>Aster can change rates, rules or end the program.</li>
    </ul>
  </section>

  <section class="space-y-3" aria-labelledby="legal-heading">
    <h2 id="legal-heading" class="font-display font-medium text-xl text-slate-100 tracking-tight">The part most affiliates skip</h2>
    <p class="text-xs text-slate-300 leading-relaxed">
      The terms state that referrers are responsible for understanding the legal implications of promoting leveraged
      trading in their region. That is not a formality. Financial promotion rules, affiliate disclosure requirements and
      restrictions on marketing high-risk products differ by country, and the platform's own eligibility list applies to
      the people you refer.
    </p>
    <div class="bg-amber-500/5 border border-amber-400/20 rounded-xl p-5 space-y-2">
      <h3 class="font-display text-sm text-amber-200">Before promoting a code</h3>
      <ul class="space-y-1.5 text-xs text-slate-300 leading-relaxed list-disc pl-5">
        <li>Check whether leveraged trading can be promoted in your audience's jurisdiction.</li>
        <li>Disclose the commission clearly and conspicuously.</li>
        <li>Do not target the prohibited jurisdictions listed in the <a href="/aster-dex/eligibility/" class="text-sky-400 hover:text-sky-300">eligibility page</a>.</li>
        <li>Do not present a referral link as financial advice or a guaranteed return.</li>
      </ul>
    </div>
  </section>

  <section class="space-y-3" aria-labelledby="this-site-heading">
    <h2 id="this-site-heading" class="font-display font-medium text-xl text-slate-100 tracking-tight">This site's position</h2>
    <p class="text-xs text-slate-400 leading-relaxed">
      No referral link is used on this page. If one is added later, it will carry <code>rel="sponsored nofollow"</code>
      and a disclosure above the link. The <a href="/disclosure/" class="text-sky-400 hover:text-sky-300">disclosure policy</a>
      explains the standard.
    </p>
  </section>

  <section class="border-t border-[#1e293b]/60 pt-6 space-y-2">
    <p class="text-[11px] text-slate-400">
      Related: <a href="/aster-dex/fees/" class="text-sky-400 hover:text-sky-300">fee schedule</a> ·
      <a href="/aster-dex/eligibility/" class="text-sky-400 hover:text-sky-300">eligibility</a> ·
      <a href="/disclosure/" class="text-sky-400 hover:text-sky-300">disclosure</a>
    </p>
    <p class="text-[11px] text-slate-400">
      Written by <a href="/kirsty-moreland/" class="text-sky-400 hover:text-sky-300">Kirsty Moreland</a> · Technical review by{" "}
      <a href="/about/" class="text-sky-400 hover:text-sky-300">Maksim Sokal</a>
    </p>
  </section>
</AsterLayout>
