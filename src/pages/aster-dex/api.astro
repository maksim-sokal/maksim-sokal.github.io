  <section id="errors" class="space-y-4 scroll-mt-24" aria-labelledby="errors-heading">
    <h2 id="errors-heading" class="font-display font-medium text-xl text-slate-100 tracking-tight">Error handling</h2>
    <div class="overflow-x-auto rounded-xl border border-[#1e293b]/60">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-brand-950/60 border-b border-[#1e293b]/40">
            <th scope="col" class="text-left text-[10px] text-slate-400 uppercase tracking-widest px-4 py-3 font-semibold">Code</th>
            <th scope="col" class="text-left text-[10px] text-slate-400 uppercase tracking-widest px-4 py-3 font-semibold">Meaning</th>
            <th scope="col" class="text-left text-[10px] text-slate-400 uppercase tracking-widest px-4 py-3 font-semibold">Action</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-[#1e293b]/30"><td class="px-4 py-3 text-xs text-slate-300 font-mono">400</td><td class="px-4 py-3 text-xs text-slate-400">Malformed request or bad parameter</td><td class="px-4 py-3 text-xs text-slate-400">Fix the request; do not retry unchanged</td></tr>
          <tr class="border-b border-[#1e293b]/30"><td class="px-4 py-3 text-xs text-slate-300 font-mono">403</td><td class="px-4 py-3 text-xs text-slate-400">WAF limit</td><td class="px-4 py-3 text-xs text-slate-400">Stop and investigate</td></tr>
          <tr class="border-b border-[#1e293b]/30"><td class="px-4 py-3 text-xs text-slate-300 font-mono">418</td><td class="px-4 py-3 text-xs text-slate-400">IP auto-banned</td><td class="px-4 py-3 text-xs text-slate-400">Wait out the ban; rotate carefully</td></tr>
          <tr class="border-b border-[#1e293b]/30"><td class="px-4 py-3 text-xs text-slate-300 font-mono">429</td><td class="px-4 py-3 text-xs text-slate-400">Rate limit</td><td class="px-4 py-3 text-xs text-slate-400">Back off with jitter</td></tr>
          <tr class="border-b border-[#1e293b]/30"><td class="px-4 py-3 text-xs text-slate-300 font-mono">5XX</td><td class="px-4 py-3 text-xs text-slate-400">Server-side error</td><td class="px-4 py-3 text-xs text-slate-400">Retry with backoff, then reconcile</td></tr>
          <tr><td class="px-4 py-3 text-xs text-slate-300 font-mono">503</td><td class="px-4 py-3 text-xs text-slate-400">Timeout; execution status unknown</td><td class="px-4 py-3 text-xs text-slate-400">Query the order before retrying</td></tr>
        </tbody>
      </table>
    </div>
    <pre class="bg-brand-950/70 border border-[#1e293b]/60 rounded-xl p-5 overflow-x-auto"><code class="text-xs text-sky-200">{`{"code": -1121, "msg": "Invalid symbol."}
{"code": -1115, "msg": "Invalid TIF"}          // spot FOK
{"code": -4227, "msg": "Request was not processed within the nonceWindow"}
{"code": -5050, "msg": "This function can only be used after deposit"}`}</code></pre>
