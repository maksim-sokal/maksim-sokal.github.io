---
import "../index.css";
import BackgroundDecor from "../components/sections/BackgroundDecor.astro";
import Header from "../components/sections/Header.astro";
import Breadcrumbs from "../components/sections/Breadcrumbs.astro";
import Footer from "../components/sections/Footer.astro";
import { buildWebsiteNode, serializeGraph } from "../lib/schema";
import type { JsonLdGraph } from "../types-schema";

const graph: JsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://maksim-sokal.github.io/sitemap/#webpage",
      url: "https://maksim-sokal.github.io/sitemap/",
      name: "HTML Sitemap | Maksim Sokal",
      description: "Complete index of all pages on the Maksim Sokal portfolio, including the DeFi profile, SEO expert profile and entity record.",
      inLanguage: "en",
      isPartOf: { "@id": "https://maksim-sokal.github.io/#website" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://maksim-sokal.github.io/sitemap/#breadcrumbs",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://maksim-sokal.github.io/" },
        { "@type": "ListItem", position: 2, name: "HTML Sitemap", item: "https://maksim-sokal.github.io/sitemap/" },
      ],
    },
    buildWebsiteNode(),
  ],
};

const serializedGraph = serializeGraph(graph);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HTML Sitemap | Maksim Sokal</title>
    <meta name="description" content="Complete index of the Maksim Sokal portfolio — DeFi analyst profile, SEO expert profile and canonical entity record, with direct links to every section." />
    <meta name="author" content="Maksim Sokal" />
    <link rel="icon" type="image/svg+xml" href="/maksim-sokal-DeFi-analyst.svg">
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b0f17" />
    <link rel="canonical" href="https://maksim-sokal.github.io/sitemap/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maksim Sokal — Professional Portfolio" />
    <meta property="og:url" content="https://maksim-sokal.github.io/sitemap/" />
    <meta property="og:title" content="HTML Sitemap | Maksim Sokal" />
    <meta property="og:description" content="Complete index of all pages on the Maksim Sokal portfolio — DeFi profile, SEO expert profile, entity record and research papers." />
    <meta property="og:image" content="https://maksim-sokal.github.io/images/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Maksim Sokal — DeFi Risk Analyst and SEO Expert" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HTML Sitemap | Maksim Sokal" />
    <meta name="twitter:description" content="Complete index of all pages on the Maksim Sokal portfolio." />
    <meta name="twitter:image" content="https://maksim-sokal.github.io/images/og-image.jpg" />

    <script type="application/ld+json" is:inline set:html={serializedGraph} />
  </head>
  <body class="relative bg-[#0b0f17] text-slate-200 antialiased min-h-screen flex flex-col overflow-x-hidden">
    <a
      href="#main-content"
