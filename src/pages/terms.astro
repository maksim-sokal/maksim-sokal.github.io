---
import LegalLayout from "../layouts/LegalLayout.astro";
import { SITE_URL, WEBSITE_ID } from "../entity";
import { buildBreadcrumbs, buildContentGraph } from "../lib/schema";

const url = `${SITE_URL}/terms/`;
const description =
  "Terms of use for maksim-sokal.github.io: informational purpose, intellectual property, external links, liability and governing law.";

const pageNode = {
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: "Terms of Use",
  description,
  inLanguage: "en",
  isPartOf: { "@id": WEBSITE_ID },
  dateModified: "2026-11-24",
};

const breadcrumbs = buildBreadcrumbs(`${url}#breadcrumbs`, [
  { name: "Home", url: `${SITE_URL}/` },
  { name: "Terms", url },
]);

const graph = buildContentGraph([pageNode, breadcrumbs]);
---

<LegalLayout
  title="Terms of Use | Maksim Sokal"
  description={description}
  canonical={url}
  graph={graph}
  label="Terms of Use"
  modified={new Date("2026-11-24")}
>
  <p>
    By using this website you agree to these terms. If you do not agree, stop using the site. The site is operated by
    Maksim Sokal as an independent professional portfolio and research publication.
  </p>

  <h2>Informational purpose</h2>
  <p>
    All content is published for information and education. It is not financial, investment, trading, legal, tax or
    accounting advice, and it is not a recommendation to buy, sell or hold any asset or to use any platform. You are
    responsible for your own decisions and for obtaining professional advice where appropriate.
  </p>

  <h2>No warranty</h2>
  <p>
    The site is provided "as is". Facts are dated and linked to sources, but no warranty is given that every page is
    complete, current or error-free. Product terms, fees, addresses and eligibility rules can change after the date on
    which a page was verified. Always confirm on the official source before acting.
  </p>

  <h2>Use of the site</h2>
  <ul>
    <li>Do not use the site to break the law or to breach a platform's terms.</li>
    <li>Do not attempt to disrupt the site or access it in a way that harms other users.</li>
    <li>Do not present the content as official documentation from Aster DEX or any other platform.</li>
  </ul>

  <h2>Intellectual property</h2>
  <p>
    Original text, layout and code on this site belong to their respective authors. Third-party names, logos and
    trademarks belong to their owners and are used only for identification and commentary. Audit reports and official
    documentation remain the property of their authors; this site links to them rather than re-publishing them.
  </p>

  <h2>External links</h2>
  <p>
    Links to third-party sites are provided for convenience. We do not control those sites and are not responsible for
    their content, availability, security or privacy practices. Following an external link is at your own risk.
  </p>

  <h2>Limitation of liability</h2>
  <p>
    To the extent permitted by law, the operator is not liable for indirect or consequential loss, or for loss arising
    from reliance on the content, from use of a third-party platform, or from market movements. Nothing in these terms
    excludes liability that cannot be excluded by law.
  </p>

  <h2>Changes</h2>
  <p>
    These terms may be updated as the site changes. The date at the top of the page shows the current version. Continued
    use after a change means you accept the updated terms.
  </p>

  <h2>Governing law</h2>
  <p>
    These terms are governed by the laws of the Republic of Belarus, without prejudice to mandatory protections you may
    have where you live.
  </p>

  <h2>Contact</h2>
  <p>
    Questions about these terms: <a href="mailto:contact@finialseo.org">contact@finialseo.org</a>.
  </p>
</LegalLayout>
