---
import { Check, ExternalLink, Mail, Send } from "lucide-react";
import { SEO_BIO } from "../../data-seo";
---

<section id="contact" class="border-t border-brand-800/30 pt-16">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start bg-brand-900/10 border border-[#1e293b]/40 rounded-2xl p-8 md:p-12">
    <div class="lg:col-span-6 space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-sky-500/5 border border-sky-400/20 rounded-full text-[10px] font-mono uppercase tracking-widest text-sky-400">
        <Mail class="w-3.5 h-3.5" /> CLIENT INTAKE GATEWAY
      </div>
      <h2 class="font-display font-medium text-3xl md:text-4xl text-slate-100 tracking-tight">Initiate An Organic Growth Strategy</h2>
      <p class="text-slate-400 text-xs md:text-sm leading-relaxed font-sans max-w-md">
        Request a technical audit, a full promotion strategy, or an E-E-A-T recovery program. Every inquiry is
        reviewed by the founders directly — no juniors, no ticket queues.
      </p>

      <div class="space-y-4 font-mono text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <span class="text-slate-500">EMAIL:</span>
          <a href={`mailto:${SEO_BIO.email}`} class="text-sky-400 hover:text-sky-300 hover:underline">{SEO_BIO.email}</a>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-slate-500">OFFICE:</span>
          <span>{SEO_BIO.location}</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-slate-500">LINKEDIN:</span>
          <a href={SEO_BIO.linkedin} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 flex items-center gap-1">
            /in/maksim-sokal <ExternalLink class="w-3 h-3" />
          </a>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-slate-500">WEBSITE:</span>
          <a href={SEO_BIO.website} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 flex items-center gap-1">
            finialseo.org <ExternalLink class="w-3 h-3" />
          </a>
        </div>
      </div>
    </div>

    <div class="lg:col-span-6 bg-brand-950/40 p-6 border border-brand-800/35 rounded-xl space-y-4">
      <h4 class="font-display font-medium text-slate-200 text-sm tracking-wide">Strategy Intake Questionnaire</h4>
      <p class="text-[11px] text-slate-400 leading-relaxed font-sans">
        For prompt review, please send your domain, current organic KPIs, target niche, and geography to the official
        email above.
      </p>

      <div class="pt-4 border-t border-brand-800/40 space-y-3">
        <div class="flex items-start gap-2 text-xs text-slate-300">
          <Check class="w-4 h-4 text-sky-400 flex-shrink-0 mt-0.5" />
          <span>Accepting new projects for Q3 / Q4 2026.</span>
        </div>
        <div class="flex items-start gap-2 text-xs text-slate-300">
          <Check class="w-4 h-4 text-sky-400 flex-shrink-0 mt-0.5" />
          <span>Free initial strategy consultation for qualified leads.</span>
        </div>
      </div>

      <a
        href="mailto:contact@finialseo.org?subject=SEO%20Strategy%20Inquiry%20-%20Maksim%20Sokal"
        class="block text-center text-xs font-mono uppercase tracking-widest bg-sky-500/10 hover:bg-sky-500/20 border border-sky-400/35 hover:border-sky-400 text-sky-300 py-3 rounded-lg transition-all duration-300 cursor-pointer"
      >
        Launch Intake Gateway
      </a>

      <p class="text-[9px] font-mono text-slate-500 flex items-center gap-1.5">
        <Send class="w-3 h-3 text-slate-600" />
        RESPONSE TIME: 24-48 HOURS
      </p>
    </div>
  </div>
</section>
