---
interface Props {
  gpgKey: string;
}
const { gpgKey } = Astro.props;
---

<p class="text-[11px] font-mono text-sky-300 bg-brand-950 p-2.5 rounded border border-brand-800/35 overflow-x-auto tracking-wide">
  {gpgKey}
</p>
<div class="flex justify-between items-center pt-1">
  <span class="text-[9px] text-slate-500 font-mono">Use key to decrypt contract signages</span>
  <button
    data-copy-gpg
    data-gpg-key={gpgKey}
    class="text-[9px] font-mono text-sky-400 hover:text-sky-300 cursor-pointer bg-sky-500/5 px-2.5 py-1.5 rounded border border-sky-400/20"
  >
    Copy GPG Public Key
  </button>
</div>

<script>
  const button = document.querySelector("[data-copy-gpg]");

  if (button) {
    const gpgKey = button.getAttribute("data-gpg-key") ?? "";
    const defaultText = "Copy GPG Public Key";

    const fallbackCopy = (text: string) => {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand("copy");
      document.body.removeChild(textarea);
    };

    button.addEventListener("click", () => {
      const done = () => {
        button.textContent = "Copied Signature Key!";
        setTimeout(() => {
          button.textContent = defaultText;
        }, 2000);
      };

      if (navigator.clipboard) {
        navigator.clipboard.writeText(gpgKey).then(done).catch(() => {
          fallbackCopy(gpgKey);
          done();
        });
      } else {
        fallbackCopy(gpgKey);
        done();
      }
    });
  }
</script>