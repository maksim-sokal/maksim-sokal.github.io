---
import {
  Award, BookOpen, Linkedin, Globe, ArrowRight, ShieldCheck
} from "lucide-react";
import { SEO_BIO, SEO_TRUST_FACTORS } from "../../data-seo";
---

<section id="hero" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center pt-4">
  <div class="lg:col-span-7 space-y-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-sky-500/5 border border-sky-400/10 rounded-full">
      <span class="w-2 h-2 bg-emerald-400 rounded-full animate-ping" aria-hidden="true"></span>
      <span class="text-[10px] uppercase font-mono tracking-widest text-sky-300">Active Organic Growth Director</span>
    </div>

    <div class="space-y-4">
      <h1 class="font-display font-bold text-5xl md:text-7xl text-slate-100 tracking-tight leading-[0.95]">
        <span class="block text-slate-400 font-light text-3xl md:text-4xl mb-2 font-sans">Strategic Growth Architect</span>
        Maksim Sokal
      </h1>
      <p class="font-display text-lg md:text-2xl text-sky-300/80 font-normal tracking-wide">
        SEO Expert & Head of Strategy
      </p>

      <div class="flex flex-wrap gap-2.5 pt-2">
        <a href="https://finialseo.org" target="_blank" rel="noopener noreferrer" aria-label="Finial SEO website" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-900/80 border border-slate-800 rounded-lg text-xs text-slate-300 hover:border-[#1e293b] hover:text-[#38bdf8] transition-all duration-300 group">
          <Award className="w-3.5 h-3.5 text-indigo-400 group-hover:scale-105 transition-transform" />
          <span class="font-mono text-[10px] uppercase tracking-wider">CEO @ Finial SEO</span>
        </a>

        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-900/80 border border-slate-800 rounded-lg text-xs text-slate-300 select-none">
          <BookOpen className="w-3.5 h-3.5 text-emerald-400" />
          <span class="font-mono text-[10px] uppercase tracking-wider">In SEO Since 2007</span>
        </span>

        <a href="https://www.linkedin.com/in/maksim-sokal/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-900/80 border border-slate-800 rounded-lg text-xs text-slate-300 hover:border-sky-500/20 hover:text-sky-300 transition-all duration-300 group">
          <Linkedin className="w-3.5 h-3.5 text-sky-400 group-hover:scale-110 transition-transform" />
          <span class="font-mono text-[10px] uppercase tracking-wider">LinkedIn</span>
        </a>

        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-900/80 border border-slate-800 rounded-lg text-xs text-slate-300 select-none">
          <ShieldCheck className="w-3.5 h-3.5 text-emerald-400" />
          <span class="font-mono text-[10px] uppercase tracking-wider">E-E-A-T / YMYL</span>
        </span>

        <a href="https://finialseo.org/en/methodology" target="_blank" rel="noopener noreferrer" aria-label="Finial SEO methodology" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-900/80 border border-slate-800 rounded-lg text-xs text-slate-300 hover:border-indigo-500/20 hover:text-indigo-300 transition-all duration-300 group">
          <Globe className="w-3.5 h-3.5 text-indigo-400 group-hover:scale-110 transition-transform" />
          <span class="font-mono text-[10px] uppercase tracking-wider font-semibold">White-Hat Only</span>
        </a>
      </div>
    </div>

    <p class="text-slate-400 max-w-xl text-sm md:text-base leading-relaxed font-sans">
      I architect white-hat organic growth systems: comprehensive SEO strategies with predictable KPIs, Google
      E-E-A-T frameworks, and international promotion across EU and US markets. As CEO &amp; Head of Strategy at
      Finial SEO, I lead every project personally — from technical audits to end-to-end ROI dashboards.
    </p>

    <div class="grid grid-cols-3 gap-6 pt-4 border-t border-brand-800/40 max-w-lg">
      <div>
        <span class="block text-xl font-mono text-slate-100 font-semibold">{SEO_BIO.experienceYears}+</span>
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">Years In SEO</span>
      </div>
      <div>
        <span class="block text-xl font-mono text-slate-100 font-semibold">{SEO_TRUST_FACTORS[1].metric}</span>
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">Avg Traffic Growth</span>
      </div>
      <div>
        <span class="block text-xl font-mono text-slate-100 font-semibold">{SEO_TRUST_FACTORS[0].metric}</span>
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">Sites In Top-10</span>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 pt-4">
      <a href="#case-studies" class="bg-sky-500/10 hover:bg-sky-500/20 border border-sky-400/40 hover:border-sky-400 text-sky-300 text-xs font-mono uppercase tracking-widest px-6 py-3.5 rounded-xl transition-all duration-300 cursor-pointer flex items-center gap-2 shadow-lg shadow-sky-500/5 group">
        <span>Explore Case Studies</span>
        <ArrowRight className="w-4 h-4 text-sky-400 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>

  <div class="lg:col-span-5 flex justify-center">
    <div class="relative w-full max-w-[340px]">
      <div class="absolute -top-6 -left-4 font-mono text-[9px] text-emerald-400 tracking-wider z-30 select-none bg-brand-950/70 backdrop-blur-md px-2 py-0.5 rounded border border-emerald-400/20 flex items-center gap-1" aria-hidden="true">
        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
        SEO_PROFILE: M.S.
      </div>
      <div class="aspect-[490/642] rounded-2xl overflow-hidden shadow-2xl group border border-[#1e293b]/50">
        <div class="absolute inset-0 border border-sky-500/10 rounded-2xl z-20 pointer-events-none"></div>
        <div class="absolute top-2 left-2 right-2 bottom-2 border border-[#1e293b]/45 rounded-xl z-20 pointer-events-none"></div>

        <div class="absolute bottom-4 right-4 font-mono text-[9px] text-emerald-400 tracking-wider z-20 select-none bg-brand-950/70 backdrop-blur-md px-2 py-0.5 rounded border border-emerald-400/20 flex items-center gap-1" aria-hidden="true">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
          STRATEGY_VERIFIED
        </div>

        <img
          src="/images/Maksim-Sokal.webp"
          alt="Maksim Sokal - SEO Expert Portrait"
          class="w-full h-full object-cover grayscale brightness-95 group-hover:grayscale-0 group-hover:scale-[1.02] transition-all duration-700 z-10 relative"
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </div>

      <div class="absolute -bottom-6 -right-4 w-40 bg-brand-900/90 border border-[#1e293b]/80 p-4 rounded-xl shadow-xl z-30 backdrop-blur-md hidden sm:block">
        <span class="block text-[9px] font-mono text-indigo-400 uppercase tracking-wider mb-1">Growth Signature</span>
        <p class="text-xs font-sans text-slate-300 font-semibold leading-snug">Data-Driven E-E-A-T Architecture</p>
      </div>
    </div>
  </div>
</section>
