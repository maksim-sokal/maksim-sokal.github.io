---
import { ChevronDown } from "lucide-react";
import { RECENT_AUDITS } from "../../data";
---

{RECENT_AUDITS.length === 0 && (
  <div class="col-span-full text-center text-slate-500 text-sm font-mono py-12">
    No audit logs available.
  </div>
)}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {RECENT_AUDITS.map((audit) => (
    <div class="bg-brand-900/35 border border-[#1e293b]/60 rounded-xl p-6 hover:border-sky-500/20 transition-all duration-300 flex flex-col justify-between">
      <div>
        <div class="flex justify-between items-start mb-4">
          <span class="text-[10px] font-mono text-sky-400 bg-sky-400/5 px-2.5 py-1 rounded border border-sky-400/10">
            {audit.category}
          </span>
          <span class="text-[11px] text-slate-400 font-mono">
            {audit.date}
          </span>
        </div>

        <h3 class="font-display font-medium text-slate-100 text-lg mb-1 tracking-tight">
          {audit.protocol}
        </h3>

        <div class="grid grid-cols-2 gap-4 my-4 font-mono text-xs bg-[#090e18] p-3 rounded-lg border border-slate-800/50">
          <div>
            <span class="text-[10px] text-slate-500 block uppercase">Audited TVL</span>
            <span class="text-slate-200 font-semibold">{audit.tvl}</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-500 block uppercase">Security Rating</span>
            <span class="text-emerald-400 font-bold">{audit.score}/100</span>
          </div>
        </div>

        <p class="text-slate-400 text-xs mb-4 leading-relaxed font-sans">
          {audit.description}
        </p>
      </div>

      <div class="border-t border-[#1e293b]/40 pt-4 mt-2">
        <details class="group">
          <summary class="w-full flex justify-between items-center gap-3 text-xs font-mono text-sky-300 hover:text-sky-200 cursor-pointer transition-colors list-none">
            <span class="group-open:hidden">View diagnostic vulnerability detail</span>
            <span class="hidden group-open:inline">Hide critical finding log</span>
            <ChevronDown className="w-3.5 h-3.5 shrink-0 transition-transform duration-300 group-open:rotate-180" />
          </summary>
          <div class="mt-3 p-3 bg-brand-950/60 rounded-lg border border-slate-800 font-mono text-[11px] text-slate-300 leading-relaxed max-w-full overflow-x-auto">
            <h5 class="text-[9px] text-sky-400 uppercase tracking-widest mb-1 font-bold">Trace Check:</h5>
            <span class="block whitespace-pre-wrap">{audit.findingsCode}</span>
          </div>
        </details>
      </div>
    </div>
  ))}
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>