---
import { ExternalLink } from "lucide-react";
import { ASTER_AUDIT_REPORTS } from "../../data";

const AUDITOR_COLORS: Record<string, string> = {
  PeckShield: "text-rose-400 bg-rose-400/5 border-rose-400/10",
  "Salus Security": "text-cyan-400 bg-cyan-400/5 border-cyan-400/10",
  Halborn: "text-orange-400 bg-orange-400/5 border-orange-400/10",
};
---

{ASTER_AUDIT_REPORTS.length === 0 && (
  <div class="text-center text-slate-500 text-sm font-mono py-12">
    No audit reports available.
  </div>
)}

<div class="hidden md:block overflow-x-auto rounded-xl border border-[#1e293b]/60">
  <table class="w-full text-sm font-mono">
    <thead>
      <tr class="bg-brand-950/60 border-b border-[#1e293b]/40">
        <th class="text-left text-[10px] text-slate-500 uppercase tracking-widest px-5 py-3 font-semibold">Audited Component</th>
        <th class="text-left text-[10px] text-slate-500 uppercase tracking-widest px-5 py-3 font-semibold">Security Auditor</th>
        <th class="text-left text-[10px] text-slate-500 uppercase tracking-widest px-5 py-3 font-semibold">Focus of Assessment</th>
        <th class="text-left text-[10px] text-slate-500 uppercase tracking-widest px-5 py-3 font-semibold">Report</th>
      </tr>
    </thead>
    <tbody>
      {ASTER_AUDIT_REPORTS.map((r) => (
        <tr class="border-b border-[#1e293b]/30 last:border-b-0 hover:bg-brand-900/20 transition-colors">
          <td class="px-5 py-4">
            <span class="text-slate-100 text-xs font-semibold">{r.component}</span>
          </td>
          <td class="px-5 py-4">
            <span
              class={`inline-block text-[11px] font-mono px-2.5 py-1 rounded border ${AUDITOR_COLORS[r.auditor] ?? "text-slate-400 bg-slate-400/5 border-slate-400/10"}`}
            >
              {r.auditor}
            </span>
          </td>
          <td class="px-5 py-4 text-slate-400 text-xs">{r.focus}</td>
          <td class="px-5 py-4">
            <a
              href={r.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sky-300 hover:text-sky-200 underline underline-offset-2 decoration-sky-500/30 transition-colors text-xs"
            >
              View PDF
              <ExternalLink className="w-3 h-3" />
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<div class="grid grid-cols-1 gap-4 md:hidden">
  {ASTER_AUDIT_REPORTS.map((r) => (
    <div class="bg-brand-900/35 border border-[#1e293b]/60 rounded-xl p-5 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-slate-100 text-sm font-semibold font-sans">{r.component}</span>
        <span
          class={`text-[10px] font-mono px-2.5 py-1 rounded border ${AUDITOR_COLORS[r.auditor] ?? "text-slate-400 bg-slate-400/5 border-slate-400/10"}`}
        >
          {r.auditor}
        </span>
      </div>
      <div>
        <span class="text-[10px] text-slate-500 uppercase tracking-wider block font-mono mb-0.5">Focus</span>
        <span class="text-slate-400 text-xs font-sans">{r.focus}</span>
      </div>
      <a
        href={r.pdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sky-300 hover:text-sky-200 underline underline-offset-2 decoration-sky-500/30 transition-colors text-xs font-mono"
      >
        View PDF
        <ExternalLink className="w-3 h-3" />
      </a>
    </div>
  ))}
</div>