---
import { Fingerprint, ExternalLink } from "lucide-react";
import { SEO_TRUST_FACTORS } from "../../data-seo";
---

<section id="trust" class="bg-brand-900/25 border border-[#1e293b]/40 rounded-2xl p-8 md:p-12 space-y-12">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-5 space-y-6">
      <span class="text-xs font-mono text-sky-400 uppercase tracking-widest block">04. Trust & Authority</span>
      <h2 class="font-display font-medium text-3xl text-slate-100 tracking-tight leading-tight">E-E-A-T Verification Pillars</h2>
      <p class="text-slate-400 text-xs md:text-sm leading-relaxed font-sans">
        True authority in search cannot be bought. It is engineered through verified expertise, first-hand experience
        layers, transparent fact-checking, and measurable business outcomes.
      </p>

      <div class="bg-[#090d16] p-4 border border-brand-800/40 rounded-xl space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Fingerprint class="w-4 h-4 text-sky-400" />
            <span class="text-[10px] uppercase font-mono tracking-wider text-slate-300">Publishing Principles</span>
          </div>
          <span class="text-[9px] text-emerald-400 font-mono bg-emerald-500/5 px-2 py-0.5 rounded border border-emerald-500/10">WHITE-HAT</span>
        </div>
        <p class="text-[10px] text-slate-400 font-mono leading-relaxed">
          finialseo.org/methodology — the engineering framework behind every engagement: White-Hat Data-Driven
          methodology, Google E-E-A-T &amp; Yandex commercial factors, ICE hypothesis prioritization.
        </p>
        <a
          href="https://finialseo.org/methodology"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[10px] font-mono text-sky-400 hover:text-sky-300 transition-colors"
        >
          <span>Verify Methodology Document</span>
          <ExternalLink class="w-3 h-3" />
        </a>
      </div>
    </div>

    <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {SEO_TRUST_FACTORS.map((tf) => (
        <div key={tf.id} class="bg-brand-950/40 border border-[#1e293b]/30 p-5 rounded-xl space-y-3 flex flex-col justify-between">
          <div class="space-y-1">
            <span class="text-[10px] font-mono text-sky-400 uppercase tracking-widest block">{tf.title}</span>
            <span class="block text-3xl font-display font-medium text-slate-100 tracking-tight text-glow">
              {tf.metric}
            </span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed font-sans pt-2 border-t border-brand-800/20">
            {tf.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
